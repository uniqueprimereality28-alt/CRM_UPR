# Public URL this service is reachable at once deployed (no trailing slash).
# Plivo MUST be able to reach this over the internet. Fill this in AFTER deploy,
# then redeploy/restart — e.g. https://voice-agent.onrender.com
PUBLIC_BASE_URL=

# ---- Plivo (telephony) — https://console.plivo.com ----
# Free trial gives test credit; production calling needs a funded account
# and (for India) a registered sender/DLT entity.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=

# ---- Shared secret with the CRM backend ----
# Generate any long random string, and put the SAME value in the CRM
# backend's .env as VOICE_AGENT_SHARED_SECRET.
VOICE_AGENT_SHARED_SECRET=change-me-to-a-long-random-string

# ---- CRM backend base URL (no trailing slash) ----
# Where this service reports finished calls: {CRM_BACKEND_URL}/api/ai/calls/ingest
CRM_BACKEND_URL=https://your-crm-backend.onrender.com

# ---- LLM (conversation brain) ----
# Default: Groq free tier — https://console.groq.com/keys (free API key, no card needed)
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# ---- STT (faster-whisper — local, free, no key) ----
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- TTS (edge-tts — free, no key) ----
# hi-IN-SwaraNeural = Indian female Hindi/Hinglish voice (default persona "Simran")
# hi-IN-MadhurNeural = Indian male
TTS_VOICE=hi-IN-SwaraNeural

# ---- Conversation tuning ----
MAX_TURNS=14
SILENCE_MS_TO_END_TURN=700
MAX_CALL_SECONDS=300

TRANSFER_TARGET_NAME=Vranda Aggarwal
TRANSFER_TARGET_NUMBER=7351735035
