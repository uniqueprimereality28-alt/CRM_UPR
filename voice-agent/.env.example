# ─── LiveKit Cloud ───
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=upr-calling-agent

# ─── Telephony: Vobiz SIP Trunk ───
# Create an Outbound SIP Trunk in LiveKit Cloud pointing to your Vobiz SIP credentials
VOBIZ_SIP_TRUNK_ID=ST_xxxxxxxxxxxx
DEFAULT_TRANSFER_NUMBER=+917351735035
DEFAULT_TRANSFER_NAME=Vranda Aggarwal
MAX_CALL_DURATION_SECONDS=600

# ─── Speech-to-Text: Deepgram ───
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3
# Language options: "hi" (Hindi / Hinglish), "en-IN" (Indian English), "en" (English), "multi" (Multilingual)
DEEPGRAM_STT_LANGUAGE=hi

# ─── LLM Brain: Groq (Ultra-Fast 600+ tokens/sec, Zero Lag) ───
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallbacks:
OPENAI_API_KEY=
GROK_API_KEY=

# ─── Text-to-Speech: Sarvam AI ───
SARVAM_API_KEY=your-sarvam-api-key
# Voices: anushka (natural female), priya (warm female), neha, pooja, aditya (male), rahul
SARVAM_SPEAKER=anushka
SARVAM_LANGUAGE_CODE=hi-IN

# Fallback TTS (Deepgram Aura)
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# ─── CRM Backend Integration ───
# Your Railway or local CRM backend URL (where finished calls and transcripts are synced)
CRM_BACKEND_URL=https://your-crm-backend.up.railway.app
VOICE_AGENT_SHARED_SECRET=make-up-a-secure-shared-secret-here
